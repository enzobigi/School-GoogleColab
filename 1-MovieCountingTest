      "cell_type": "code",
      "source": [
        "friend_lists = [\n",
        "    [\"Inception\", \"The Dark Knight\", \"Interstellar\"],\n",
        " [\"Inception\", \"The Matrix\", \"The Dark Knight\"],\n",
        " [\"The Matrix\", \"Pulp Fiction\", \"Inception\"]\n",
        "]\n",
        "\n",
        "amount_friends = len(friend_lists)\n",
        "\n",
        "onlyone_list = []\n",
        "\n",
        "amount = {}\n",
        "\n",
        "\n",
        "\n",
        "for option in range(3):\n",
        "  for listt in range(amount_friends):\n",
        "    movie = friend_lists[listt][option]\n",
        "    if movie not in onlyone_list:\n",
        "      onlyone_list.append(movie)\n",
        "      amount[(movie)] = 1\n",
        "    elif movie in onlyone_list:\n",
        "      amount[(movie)] +=1\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "print(onlyone_list)\n",
        "print(amount)"
      ],
